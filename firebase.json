{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "dataconnect/**",
      "module/**",
      "*.log",
      "package.json",
      "package-lock.json"
    ]
  }
}
